#version 450

layout(local_size_x = 16, local_size_y = 16) in;

// Time in seconds
layout (push_constant) uniform PushConstants {
    float t;        // time
} consts;

// set 2
//  binding 0 - 15:     textures
//  binding 16 - 23:    SSBO
//  binding 24 - 31:    storage image
// Output height map
layout(r32f, set = 2, binding = 24) uniform writeonly image2D outHeight;

// Simple hash-based value noise helpers
float hash(vec2 p)
{
    p = fract(p * vec2(123.34, 456.21));
    p += dot(p, p + 45.32);
    return fract(p.x * p.y);
}

float noise(vec2 p)
{
    vec2 i = floor(p);
    vec2 f = fract(p);

    float a = hash(i);
    float b = hash(i + vec2(1.0, 0.0));
    float c = hash(i + vec2(0.0, 1.0));
    float d = hash(i + vec2(1.0, 1.0));

    vec2 u = f * f * (3.0 - 2.0 * f);

    return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
}

float fbm(vec2 p)
{
    float sum = 0.0;
    float amp = 0.5;
    float freq = 1.0;

    for (int i = 0; i < 4; ++i)
    {
        sum += amp * noise(p * freq);
        freq *= 2.0;
        amp *= 0.5;
    }

    return sum;
}

void main()
{
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outHeight);

    if (coord.x >= size.x || coord.y >= size.y) {
        return;
    }

    vec2 uv = (vec2(coord) + 0.5) / vec2(size);

    float t = consts.t;

    // Left side is attached to the pole, right side moves more.
    float attachment = smoothstep(0.0, 0.15, uv.x);

    // Main traveling folds
    float wave1 = sin(uv.x * 10.0 - t * 3.0);
    float wave2 = sin(uv.x * 18.0 - t * 5.2 + uv.y * 1.3);
    float wave3 = sin(uv.x * 6.0  - t * 2.1 + uv.y * 3.7);

    // Secondary flutter noise
    float flutter = fbm(vec2(uv.x * 7.0 - t * 1.8, uv.y * 5.0 + t * 0.4));
    flutter = flutter * 2.0 - 1.0;

    // Make the right side flap more strongly
    float amplitudeRamp = pow(uv.x, 0.7);

    // Slight vertical shaping so the center moves a bit more naturally
    float verticalProfile = 0.85 + 0.15 * sin(uv.y * 3.14159);

    float h =
          0.55 * wave1
        + 0.25 * wave2
        + 0.15 * wave3
        + 0.20 * flutter;

    h *= amplitudeRamp * verticalProfile * attachment;

    // Tiny extra wrinkle banding for cloth feel
    float wrinkle = sin((uv.x * 40.0 - t * 8.0) + uv.y * 12.0) * 0.05 * amplitudeRamp;
    h += wrinkle;

    // Clamp to required range [-1, 1]
    h = clamp(h, -1.0, 1.0);

    imageStore(outHeight, coord, vec4(h, 0.0, 0.0, 0.0));
}